opam-version: "2.0"
maintainer: "FVQKD authors"
synopsis: "Formal verification of QKD protocols"
description: """\
Formal verification of BB84 quantum key distribution protocol
using the CoqQ quantum computing library."""
pin-depends: [
  [
    "coq-mathcomp-quantum.dev"
    "git+https://github.com/fvqkd/CoqQ.git#rocq91-v1.0"
  ]
]
build: ["dune" "build" "-p" name "-j" jobs]
name: "coq-mathcomp-qkd"
version: "dev"
depends: [
  "atd" {= "4.2.0"}
  "atdgen" {= "4.2.0"}
  "atdgen-runtime" {= "4.2.0"}
  "atdts" {= "4.2.0"}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "biniou" {= "1.2.2"}
  "camlp-streams" {= "5.0.1"}
  "cmdliner" {= "2.1.1"}
  "conf-gmp" {= "5"}
  "conf-pkg-config" {= "4"}
  "coq-core" {= "9.1.1"}
  "coq-mathcomp-algebra" {= "2.5.0"}
  "coq-mathcomp-bigenough" {= "1.0.4"}
  "coq-mathcomp-field" {= "2.5.0"}
  "coq-mathcomp-quantum" {= "dev"}
  "coq-mathcomp-real-closed" {= "2.0.3"}
  "coq-mathcomp-ssreflect" {= "2.5.0"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.23.0"}
  "dune-configurator" {= "3.23.0"}
  "easy-format" {= "1.3.4"}
  "elpi" {= "3.6.2"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "5.2.1"}
  "ocaml-base-compiler" {= "5.2.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlfind" {= "1.9.8"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.1.1"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "re" {= "1.14.0"}
  "rocq-core" {= "9.1.1"}
  "rocq-elpi" {= "3.3.1"}
  "rocq-hierarchy-builder" {= "1.10.2"}
  "rocq-mathcomp-algebra" {= "2.5.0"}
  "rocq-mathcomp-analysis" {= "1.16.0"}
  "rocq-mathcomp-bigenough" {= "1.0.4"}
  "rocq-mathcomp-boot" {= "2.5.0"}
  "rocq-mathcomp-classical" {= "1.16.0"}
  "rocq-mathcomp-field" {= "2.5.0"}
  "rocq-mathcomp-fingroup" {= "2.5.0"}
  "rocq-mathcomp-finmap" {= "2.2.2"}
  "rocq-mathcomp-order" {= "2.5.0"}
  "rocq-mathcomp-reals" {= "1.16.0"}
  "rocq-mathcomp-solvable" {= "2.5.0"}
  "rocq-mathcomp-ssreflect" {= "2.5.0"}
  "rocq-runtime" {= "9.1.1"}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
